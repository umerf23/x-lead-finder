# =====================================================================
#  SETTINGS FILE
#  This is the only file a non-technical person needs to edit.
#  Change what the tool watches for, and how much it is allowed to
#  spend, without touching any code.
#
#  Rules for editing:
#    - Keep the spacing exactly as it is. Indentation matters here.
#    - Text with special characters goes inside single quotes.
#    - Lines starting with # are notes and are ignored by the program.
# =====================================================================

# ---------------------------------------------------------------------
# SPENDING PROTECTION
# ---------------------------------------------------------------------

# The most posts the tool may pull in one run, across all watchlists.
# Keep this low while testing. 40 is plenty to build with.
max_posts_per_run: 40

# The most posts to pull from any single watchlist.
max_posts_per_watchlist: 20

# Roughly what 1000 posts cost, in US dollars.
# Used only to show you an estimate before spending. Update if the
# supplier changes their price.
cost_per_1000_posts: 0.15

# The most posts any single author may have in your store, counted
# across every run, not just the current one. This stops one loud
# account filling your top results. Two is a sensible starting point,
# because once you know somebody is looking for help you only need to
# contact them once. Raise it if you would rather see every post from
# an active buyer.
max_posts_per_author: 2

# The most pages the tool may request per watchlist. Each page costs
# money and holds roughly 20 posts. Three pages is enough to fill a
# 20 post watchlist even when many results are duplicates.
max_pages_per_watchlist: 3

# If true, the tool asks you to type yes before spending anything.
# Leave this on until you trust it.
confirm_before_spending: true


# ---------------------------------------------------------------------
# WHAT TO WATCH FOR
# ---------------------------------------------------------------------
# Each watchlist has three parts:
#   name        a label you will see in the results
#   description plain English, used later by the scoring step
#   query       the actual search sent to X
#   enabled     true or false, to switch a watchlist on or off
#
# Query building blocks you can reuse:
#   "exact phrase"      matches those words together
#   OR                  matches either side
#   lang:en             English posts only
#   -filter:retweets    exclude reposts
#   -filter:replies     exclude replies
# ---------------------------------------------------------------------

watchlists:

  - name: AI UGC video
    description: >
      People asking someone to create AI generated user generated
      content style videos, avatar ads, or faceless video content
      for them.
    query: '("AI UGC" OR "UGC video" OR "faceless video" OR "avatar video") ("looking for" OR "need someone" OR "anyone know" OR "who can make") lang:en -filter:retweets'
    enabled: true

  - name: Custom AI workflows
    description: >
      People asking for help building an automation, an AI agent,
      or a custom workflow that connects their tools together.
    query: '(n8n OR Zapier OR "Make.com" OR "AI agent" OR "AI workflow") ("need help" OR "looking for someone" OR "who can build" OR "anyone build") lang:en -filter:retweets'
    enabled: true

  - name: General automation help
    description: >
      People describing a manual repetitive task and asking whether
      anyone can automate it for them.
    query: '("automate this" OR "automate my" OR "tired of doing manually") ("anyone" OR "looking for" OR "need someone" OR "recommend") lang:en -filter:retweets'
    enabled: false
